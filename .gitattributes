# The rulebook is a verbatim copy of the league's document. Pin its line endings
# so a checkout on Windows cannot quietly rewrite a file whose whole point is that
# it matches the source character for character.
rulebook/*.txt   text eol=lf
rulebook/*.docx  binary
rulebook/media/* binary

# Generated by generator/extract_rulebook.py and generator/render.py — same reason.
*.py             text eol=lf
